<?xml version="1.0" ?>
<!-- ====================================================================
     OTOMATIK URETILDI. Elle duzenleme kalici olmaz.
     Kaynak: ros2_ws/src/mergen_avoidance/mergen_avoidance/sim2d.py
             scenario("w9_parkur")
     Yeniden uretmek icin: python3 scripts/generate_worlds.py w9_parkur
     ==================================================================== -->
<sdf version="1.6">
  <world name="w9_parkur">

    <!-- Isik ve zemin DOGRUDAN burada tanimli; model://ground_plane gibi
         harici modeller Gazebo Fuel'den indirilmeye calisilir ve internet
         yoksa dunya acilmaz. Self-contained olmasi kasitli. -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.6 0.7 0.8 1</background>
      <shadows>true</shadows>
    </scene>

    <physics type="ode">
      <!-- 1 ms adim / 1000 Hz: diff_drive ve lidar icin fazlasiyla yeterli.
           Toplu testte hizlandirmak icin real_time_update_rate'i 0 yap
           (olabildigince hizli kos); bkz. scripts/batch_test.sh -->
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <model name="wall_0">
      <static>true</static>
      <pose>9.000 2.000 0.350 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>24.000 0.200 0.700</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>24.000 0.200 0.700</size></box></geometry>
          <material>
            <ambient>0.75 0.75 0.78 1</ambient>
            <diffuse>0.85 0.85 0.88 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_1">
      <static>true</static>
      <pose>9.000 -2.000 0.350 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>24.000 0.200 0.700</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>24.000 0.200 0.700</size></box></geometry>
          <material>
            <ambient>0.75 0.75 0.78 1</ambient>
            <diffuse>0.85 0.85 0.88 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="cone_0">
      <static>true</static>
      <pose>2.500 0.000 0.350 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.250</radius><length>0.700</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.250</radius><length>0.700</length></cylinder></geometry>
          <material>
            <ambient>0.9 0.35 0.05 1</ambient>
            <diffuse>1.0 0.45 0.05 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

